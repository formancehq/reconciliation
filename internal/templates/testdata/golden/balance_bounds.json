{
  "template": "balance_bounds",
  "about": "Golden cases for balance_bounds: template inputs, resolved source reads, and the expected verdict per asset. They describe the target semantics of reconciliation v3 (RFC 0022, ADR-006) and are independent of any implementation. Amounts are integer strings in minor units of the asset (USD/2 counts cents). Tolerances are major units per asset, with a mandatory '*' default (review decision 12c). A case listing 'v3-tolerances' in 'requires' needs per-asset tolerances that the prototype cannot express. 'expect' lists one entry per outcome, sorted by asset, and names only the decisive values: a port maps them to its own evidence fields. 'invalid' means the spec must be rejected at rule creation. 'evaluationError' means evaluation must fail as a whole.",
  "cases": [
    {
      "name": "within_bounds",
      "description": "A balance strictly inside [min, max] passes with no excursion.",
      "spec": {
        "source": {
          "id": "treasury",
          "ledger": "main",
          "query": {
            "$match": {
              "address": "treasury:"
            }
          },
          "asset": "USD/2"
        },
        "bounds": {
          "USD/2": {
            "min": "100",
            "max": "1000"
          }
        }
      },
      "reads": {
        "treasury": {
          "balances": {
            "USD/2": "500"
          }
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": true,
          "excursion": "0"
        }
      ]
    },
    {
      "name": "below_min",
      "description": "Below min fails on min. The excursion is the signed distance to the breached bound.",
      "spec": {
        "source": {
          "id": "treasury",
          "ledger": "main",
          "query": {
            "$match": {
              "address": "treasury:"
            }
          },
          "asset": "USD/2"
        },
        "bounds": {
          "USD/2": {
            "min": "100",
            "max": "1000"
          }
        }
      },
      "reads": {
        "treasury": {
          "balances": {
            "USD/2": "50"
          }
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": false,
          "breachedBound": "min",
          "excursion": "-50"
        }
      ]
    },
    {
      "name": "above_max",
      "description": "Above max fails on max.",
      "spec": {
        "source": {
          "id": "treasury",
          "ledger": "main",
          "query": {
            "$match": {
              "address": "treasury:"
            }
          },
          "asset": "USD/2"
        },
        "bounds": {
          "USD/2": {
            "min": "100",
            "max": "1000"
          }
        }
      },
      "reads": {
        "treasury": {
          "balances": {
            "USD/2": "1500"
          }
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": false,
          "breachedBound": "max",
          "excursion": "500"
        }
      ]
    },
    {
