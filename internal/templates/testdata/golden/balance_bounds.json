    {
      "name": "metadata_source",
      "description": "An account_metadata source sums the integer values of its key across the matched accounts.",
      "spec": {
        "source": {
          "id": "stmt",
          "kind": "account_metadata",
          "ledger": "bank",
          "query": {
            "$match": {
              "address": "stmt:"
            }
          },
          "metadataKey": "closingBalance",
          "asset": "USD/2"
        },
        "bounds": {
          "USD/2": {
            "min": "1000"
          }
        }
      },
      "reads": {
        "stmt": {
          "accounts": [
            {
              "address": "stmt:0",
              "metadata": {
                "closingBalance": "600"
              }
            },
            {
              "address": "stmt:1",
              "metadata": {
                "closingBalance": "300"
              }
            }
          ]
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": false,
          "breachedBound": "min",
          "excursion": "-100"
        }
      ]
    },
