          }
        }
      },
      "reads": {
        "treasury": {
          "balances": {}
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": false,
          "breachedBound": "min",
          "excursion": "-1"
        }
      ]
    },
    {
      "name": "bound_beyond_int64",
      "description": "A 1e20 bound is valid. The prototype's CEL compile rejected it at rule creation (review finding M10); the Go check must accept it.",
      "spec": {
        "source": {
          "id": "treasury",
          "ledger": "main",
          "query": {
            "$match": {
              "address": "treasury:"
            }
          },
          "asset": "USD/2"
        },
        "bounds": {
          "USD/2": {
            "max": "100000000000000000000"
          }
        }
      },
      "reads": {
        "treasury": {
          "balances": {
            "USD/2": "50000000000000000000"
          }
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": true,
          "excursion": "0"
        }
      ]
    },
    {
      "name": "wildcard_checks_bounded_assets_only",
      "description": "A wildcard source checks every asset that has a bound and ignores the others (GBP/2 here).",
      "spec": {
        "source": {
          "id": "treasury",
          "ledger": "main",
          "query": {
            "$match": {
              "address": "treasury:"
            }
          },
          "asset": "*"
        },
        "bounds": {
          "USD/2": {
            "min": "0",
            "max": "1000"
          },
          "EUR/2": {
            "min": "0"
          }
        }
      },
      "reads": {
        "treasury": {
          "balances": {
            "USD/2": "2000",
            "EUR/2": "-5",
            "GBP/2": "999"
          }
        }
      },
      "expect": [
        {
          "asset": "EUR/2",
          "passed": false,
          "breachedBound": "min",
          "excursion": "-5"
        },
        {
          "asset": "USD/2",
          "passed": false,
          "breachedBound": "max",
          "excursion": "1000"
        }
      ]
    },
    {
      "name": "wildcard_bounded_asset_not_held",
