{
  "template": "balance_equation",
  "about": "Golden cases for balance_equation: template inputs, resolved source reads, and the expected verdict per asset. They describe the target semantics of reconciliation v3 (RFC 0022, ADR-006) and are independent of any implementation. Amounts are integer strings in minor units of the asset (USD/2 counts cents). Tolerances follow review decision 12c: 'tolerances' holds per-asset entries in minor units, and an asset without an entry is checked exactly. There is no default and nothing is ever converted or rounded. A case listing 'v3-tolerances' in 'requires' needs per-asset tolerances that the prototype cannot express. 'expect' lists one entry per outcome, sorted by asset, and names only the decisive values: a port maps them to its own evidence fields. 'invalid' means the spec must be rejected at rule creation. 'evaluationError' means evaluation must fail as a whole.",
  "cases": [
    {
      "name": "exact_equation",
      "description": "a + b - c = 0.",
      "spec": {
        "sources": [
          {
            "id": "a",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "a:"
              }
            },
            "asset": "USD/2"
          },
          {
            "id": "b",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "b:"
              }
            },
            "asset": "USD/2"
          },
          {
            "id": "c",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "c:"
              }
            },
            "asset": "USD/2"
          }
        ],
        "terms": [
          {
            "source": "a",
            "coefficient": 1
          },
          {
            "source": "b",
            "coefficient": 1
          },
          {
            "source": "c",
            "coefficient": -1
          }
        ]
      },
      "reads": {
        "a": {
          "balances": {
            "USD/2": "100"
          }
        },
        "b": {
          "balances": {
            "USD/2": "50"
          }
        },
        "c": {
          "balances": {
            "USD/2": "150"
          }
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": true,
          "residual": "0",
          "absoluteResidual": "0"
        }
      ]
    },
