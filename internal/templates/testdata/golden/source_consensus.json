        "bank": {
          "balances": {}
        },
        "book": {
          "balances": {
            "USD/2": "0"
          }
        },
        "psp": {
          "balances": {
            "USD/2": "0"
          }
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": false,
          "spread": "0",
          "missingSources": [
            "bank"
          ]
        }
      ]
    },
    {
      "name": "wildcard_missing_per_asset",
      "description": "With a wildcard, an asset missing from one source fails for that asset only.",
      "spec": {
        "sources": [
          {
            "id": "bank",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "bank:"
              }
            },
            "asset": "*"
          },
          {
            "id": "book",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "book:"
              }
            },
            "asset": "*"
          },
          {
            "id": "psp",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "psp:"
              }
            },
            "asset": "*"
          }
        ]
      },
      "reads": {
        "bank": {
          "balances": {
            "USD/2": "100",
            "EUR/2": "50"
          }
        },
        "book": {
          "balances": {
            "USD/2": "100"
          }
        },
        "psp": {
          "balances": {
            "USD/2": "100",
            "EUR/2": "50"
          }
        }
      },
      "expect": [
        {
          "asset": "EUR/2",
          "passed": false,
          "missingSources": [
            "book"
          ]
        },
        {
          "asset": "USD/2",
          "passed": true,
          "spread": "0",
          "missingSources": []
        }
      ]
    },
    {
      "name": "metadata_source_agrees_with_ledger",
      "description": "An account_metadata source sums its key across the matched accounts: 1000 + 500 = 1500.",
      "spec": {
        "sources": [
          {
            "id": "ledger",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "ledger:"
              }
            },
            "asset": "USD/2"
          },
          {
            "id": "statement",
            "kind": "account_metadata",
            "ledger": "bank",
            "query": {
              "$match": {
                "address": "statement:"
              }
            },
            "metadataKey": "closingBalance",
            "asset": "USD/2"
          }
        ]
      },
      "reads": {
        "ledger": {
          "balances": {
            "USD/2": "1500"
          }
        },
        "statement": {
          "accounts": [
            {
              "address": "stmt:0",
              "metadata": {
                "closingBalance": "1000"
              }
            },
            {
              "address": "stmt:1",
              "metadata": {
                "closingBalance": "500"
              }
            }
          ]
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": true,
          "spread": "0",
          "missingSources": []
        }
      ]
    },
