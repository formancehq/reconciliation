{
  "template": "source_consensus",
  "about": "Golden cases for source_consensus: template inputs, resolved source reads, and the expected verdict per asset. They describe the target semantics of reconciliation v3 (RFC 0022, ADR-006) and are independent of any implementation. Amounts are integer strings in minor units of the asset (USD/2 counts cents). Tolerances follow review decision 12c: 'tolerances' holds per-asset entries in minor units, and an asset without an entry is checked exactly. There is no default and nothing is ever converted or rounded. A case listing 'v3-tolerances' in 'requires' needs per-asset tolerances that the prototype cannot express. 'expect' lists one entry per outcome, sorted by asset, and names only the decisive values: a port maps them to its own evidence fields. 'invalid' means the spec must be rejected at rule creation. 'evaluationError' means evaluation must fail as a whole.",
  "cases": [
    {
      "name": "all_equal",
      "description": "Equal sources pass. On a tie, the first source in spec order is both minimum and maximum.",
      "spec": {
        "sources": [
          {
            "id": "bank",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "bank:"
              }
            },
            "asset": "USD/2"
          },
          {
            "id": "book",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "book:"
              }
            },
            "asset": "USD/2"
          },
          {
            "id": "psp",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "psp:"
              }
            },
            "asset": "USD/2"
          }
        ]
      },
      "reads": {
        "bank": {
          "balances": {
            "USD/2": "1000"
          }
        },
        "book": {
          "balances": {
            "USD/2": "1000"
          }
        },
        "psp": {
          "balances": {
            "USD/2": "1000"
          }
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": true,
          "spread": "0",
          "minimumSource": "bank",
          "maximumSource": "bank",
          "missingSources": []
        }
      ]
    },
    {
      "name": "spread_within_tolerance",
      "description": "A tolerance of 2 on USD/2 is 2 cents on the max-minus-min spread, inclusive.",
      "spec": {
        "sources": [
          {
            "id": "bank",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "bank:"
              }
            },
            "asset": "USD/2"
          },
          {
            "id": "book",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "book:"
              }
            },
            "asset": "USD/2"
          },
          {
            "id": "psp",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "psp:"
              }
            },
            "asset": "USD/2"
          }
        ],
        "tolerances": {
          "USD/2": "2"
        }
      },
      "reads": {
        "bank": {
          "balances": {
            "USD/2": "1000"
          }
        },
        "book": {
          "balances": {
            "USD/2": "1001"
          }
        },
        "psp": {
          "balances": {
            "USD/2": "1002"
          }
        }
      },
      "expect": [
        {
          "asset": "USD/2",
          "passed": true,
          "spread": "2",
          "minimumSource": "bank",
          "maximumSource": "psp"
        }
      ]
    },
