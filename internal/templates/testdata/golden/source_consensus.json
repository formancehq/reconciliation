    {
      "name": "unlisted_asset_is_exact",
      "requires": [
        "v3-tolerances"
      ],
      "description": "An asset without a tolerance entry is checked exactly: USD/2 tolerates 100, JPY has no entry and fails at a spread of 2.",
      "spec": {
        "sources": [
          {
            "id": "bank",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "bank:"
              }
            },
            "asset": "*"
          },
          {
            "id": "book",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "book:"
              }
            },
            "asset": "*"
          },
          {
            "id": "psp",
            "ledger": "main",
            "query": {
              "$match": {
                "address": "psp:"
              }
            },
            "asset": "*"
          }
        ],
        "tolerances": {
          "USD/2": "100"
        }
      },
      "reads": {
        "bank": {
          "balances": {
            "USD/2": "0",
            "JPY": "0"
          }
        },
        "book": {
          "balances": {
            "USD/2": "100",
            "JPY": "2"
          }
        },
        "psp": {
          "balances": {
            "USD/2": "50",
            "JPY": "1"
          }
        }
      },
      "expect": [
        {
          "asset": "JPY",
          "passed": false,
          "spread": "2"
        },
        {
          "asset": "USD/2",
          "passed": true,
          "spread": "100"
        }
      ]
    },
