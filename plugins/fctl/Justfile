set shell := ["bash", "-euo", "pipefail", "-c"]

validate-sdk:
    GOWORK=off go test ./scripts
    ./scripts/test-coverage-gate.sh
    ./scripts/test-fctl-sdk-contract.sh
    ./scripts/test-tidy-with-fctl-sdk.sh
    ./scripts/with-fctl-sdk.sh true

tidy:
    ./scripts/with-fctl-sdk.sh ./scripts/tidy-with-fctl-sdk.sh

tidy-check:
    ./scripts/with-fctl-sdk.sh ./scripts/tidy-with-fctl-sdk.sh --check

test-application:
    profile="$(mktemp "${TMPDIR:-/tmp}/reconciliation-fctl-coverage.XXXXXXXX")"; trap 'rm -f -- "$profile"' EXIT; ./scripts/with-fctl-sdk.sh go test -race -tags=fctl_component_guest -covermode=atomic -coverprofile="$profile" ./... -count=1; ./scripts/check-coverage.sh "$profile" 80

test: validate-sdk tidy-check test-application

build-component: test
    ./scripts/with-fctl-sdk.sh ./scripts/build-component.sh
